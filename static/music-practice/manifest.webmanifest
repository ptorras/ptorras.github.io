{
  "name": "Music Practice",
  "short_name": "Music Practice",
  "description": "Score reading, sight reading, technique, chords and ear training for piano and guitar, with MIDI keyboard and guitar input.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1e3a8a",
  "categories": ["music", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.recordare.musicxml+xml": [".musicxml", ".xml"],
        "application/vnd.recordare.musicxml": [".mxl"]
      }
    }
  ]
}
